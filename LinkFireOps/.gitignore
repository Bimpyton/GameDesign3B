# =========================
# Unreal Engine GitIgnore
# =========================

# Visual Studio
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Xcode
*.xcodeproj
*.xcworkspace

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Fortran module files
*.mod

# Unreal Build Products
Binaries/*
Plugins/**/Binaries/*
Build/*
Intermediate/*
Plugins/**/Intermediate/*
DerivedDataCache/*
Saved/*

# Map Build Data (auto-generated)
*_BuiltData.uasset

# Precompiled Assets (raw source art)
SourceArt/**/*.png
SourceArt/**/*.tga

# Cooked / Packaged Assets (very large)
*.ucas
*.utoc
*.pak
*.sig

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico
